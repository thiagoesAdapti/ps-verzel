# Local destination configuration only. Copy to .env and replace placeholders.
NODE_ENV=development
PORT=3300
APP_ORIGIN=http://localhost:5373
DATABASE_URL=postgresql://auction_entregavel:CHANGE_ME@localhost:5432/auction_house_entregavel_dev?schema=public
